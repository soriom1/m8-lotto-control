{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M8_ROUND_LEDGER_EVENT_SCHEMA_V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema","event_type","event_id","created_at_utc","prev_event_sha256","payload"],
  "properties": {
    "schema": {"const": "M8_ROUND_LEDGER_EVENT_V1"},
    "event_type": {"enum": ["PREDRAW_REGISTERED","OUTCOME_AUTHENTICATED","SCORE_APPENDED","CORRECTION_APPENDED","ADMIN_MISSED","ISSUE_OPENED"]},
    "event_id": {"type":"string","minLength":1},
    "created_at_utc": {"type":"string","format":"date-time"},
    "prev_event_sha256": {"type":"string","pattern":"^(GENESIS|[0-9a-f]{64})$"},
    "payload": {"type":"object"}
  },
  "allOf": [
    {
      "if": {"properties":{"event_type":{"const":"PREDRAW_REGISTERED"}},"required":["event_type"]},
      "then": {
        "properties": {"payload": {
          "type":"object",
          "required":["round","authority_sha256","timestamp_status"],
          "properties": {
            "round":{"type":"integer","minimum":1244},
            "authority_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "timestamp_status":{"enum":["ON_TIME","TRACK_ONLY"]}
          }
        }}
      }
    },
    {
      "if": {"properties":{"event_type":{"const":"CORRECTION_APPENDED"}},"required":["event_type"]},
      "then": {
        "properties": {"payload": {
          "type":"object",
          "required":["round","superseded_event_sha256","superseded_event_type","correction_payload_sha256","reason"],
          "properties": {
            "superseded_event_type":{"enum":["OUTCOME_AUTHENTICATED","SCORE_APPENDED"]},
            "superseded_event_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "correction_payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        }}
      }
    }
  ]
}
