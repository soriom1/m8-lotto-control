{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M8_ROUND_AUTHORITY_SCHEMA_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "round",
    "schedule",
    "release",
    "prediction_artifacts",
    "scoring_policy_sha256",
    "prospective_monitors",
    "prev_round_ledger_head_sha256"
  ],
  "properties": {
    "schema": {
      "const": "M8_ROUND_AUTHORITY_V1"
    },
    "round": {
      "type": "integer",
      "minimum": 1244
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draw_time_kst",
        "cutoff_time_kst"
      ],
      "properties": {
        "draw_time_kst": {
          "type": "string",
          "format": "date-time"
        },
        "cutoff_time_kst": {
          "type": "string",
          "format": "date-time"
        },
        "schedule_exception_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "whole19",
        "method_repro",
        "selector_anchor"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "whole19": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method_repro": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selector_anchor": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "prediction_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "artifact_sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "PRODUCTION",
              "F2_SHADOW",
              "OTHER_APPROVED_SHADOW"
            ]
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "contains": {
        "type": "object",
        "properties": {
          "role": {
            "const": "PRODUCTION"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "scoring_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prospective_monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monitor_id",
          "config_sha256",
          "code_sha256"
        ],
        "properties": {
          "monitor_id": {
            "type": "string",
            "minLength": 1
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "code_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "prev_round_ledger_head_sha256": {
      "type": "string",
      "pattern": "^(GENESIS|[0-9a-f]{64})$"
    },
    "supersedes_unsealed_authority_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
