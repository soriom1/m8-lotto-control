{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M8_RELEASE_REGISTRY_EVENT_SCHEMA_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_type",
    "event_id",
    "created_at_utc",
    "prev_event_sha256",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "M8_RELEASE_REGISTRY_EVENT_V1"
    },
    "event_type": {
      "enum": [
        "RELEASE_APPROVED",
        "RELEASE_REVOKED"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "prev_event_sha256": {
      "type": "string",
      "pattern": "^(GENESIS|[0-9a-f]{64})$"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "RELEASE_APPROVED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "release_id",
              "whole19",
              "method_repro",
              "selector_anchor",
              "tsa_trust_policy_sha256"
            ],
            "properties": {
              "release_id": {
                "type": "string",
                "minLength": 1
              },
              "whole19": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "method_repro": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "selector_anchor": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "tsa_trust_policy_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
